# Secreto: contiene el PAT (ACCESS_TOKEN). NUNCA se commitea.
.env
.env.*

# Modo --secret: el PAT como file-secret. NUNCA se commitea.
access_token

# Compose generado por deploy.sh (específico de cada máquina).
compose.yaml
compose.yml

# Datos locales del runner / logs.
_work/
*.log

# Hooks del vigía: cada uno guarda su credencial (token de bot, URL de ping).
# Normalmente viven en ~/.config/gh-runner/hooks.d, pero si alguien los pone en
# el directorio del despliegue, que no acaben en un commit.
hooks.d/
